{
  "name": "pto-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@microlink/react-json-view": "1.31.33",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@navikt/fnrvalidator": "2.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react-modal": "3.16.3",
    "classnames": "2.5.1",
    "constate": "4.0.0",
    "dayjs": "1.11.21",
    "less": "4.9.1",
    "prop-types": "15.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-toastify": "11.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "msw": "2.15.0",
    "prettier": "3.8.4",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "build",
      "public"
    ]
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
